# --- LLM -------------------------------------------------------------------------------
# Leave empty to run in demo mode with the deterministic FakeLLMClient.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
USE_FAKE_LLM=true
# Prices per million tokens (USD) used for cost estimation in reports.
LLM_INPUT_PRICE_PER_MTOK=4.0
LLM_OUTPUT_PRICE_PER_MTOK=20.0

# --- API -------------------------------------------------------------------------------
# When set, every request (except /health) must send `X-API-Key: <value>`.
API_KEY=
MAX_CONCURRENCY=4
MAX_CONVERSATIONS_PER_JOB=200
MAX_MESSAGES_PER_CONVERSATION=500

# --- Misc ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RUBRICS_DIR=./rubrics
